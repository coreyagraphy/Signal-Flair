# Signal Flair — environment variables
# Copy to .env.local for local dev, or set in Netlify → Site settings → Environment variables.
# Every value here is build-time inlined (NEXT_PUBLIC_ prefix) because the site is a static export.

# Google Analytics 4 Measurement ID (GA4 → Admin → Data Streams → your stream → "G-XXXXXXXXXX").
# Leave empty / unset to disable analytics entirely (no gtag script, no events). Set it to go live.
NEXT_PUBLIC_GA_ID=

# GHL inbound-webhook URL for the lead-capture form (GHL → Automation → Workflows → Inbound
# Webhook trigger → copy the URL). Leave empty to keep the form in DEMO MODE (validates + shows
# success + console.logs the payload, NO network call). Set it to start pushing real leads to GHL.
NEXT_PUBLIC_GHL_WEBHOOK_URL=
