# Signal Flair — environment variables
# Copy to .env.local for local dev, or set in Netlify → Site settings → Environment variables.
# NEXT_PUBLIC_ values are build-time inlined (static export) — changing one needs a rebuild.

# Google Analytics 4 Measurement ID (GA4 → Admin → Data Streams → your stream → "G-XXXXXXXXXX").
# Leave empty / unset to disable analytics entirely (no gtag script, no events). Set it to go live.
NEXT_PUBLIC_GA_ID=

# ─────────────────────────────────────────────────────────────────────────────
# Lead routing — Netlify Forms is the ONLY live channel (no env var needed).
# The /pulse form (name "signal-pulse") is registered via data-netlify markup in the
# static export; Netlify → Forms → Notifications emails every submission to
# outreach@trysignalflair.com.
#
# GoHighLevel was RETIRED 2026-08-18. Do not reintroduce GHL_* vars. Unset any
# leftovers in Netlify (NEXT_PUBLIC_GHL_WEBHOOK_URL, GHL_API_KEY, GHL_LOCATION_ID).
#
# BOS (planned): when BOS connects to the website, point the optional fallback
# webhooks below at the BOS intake endpoint. They are only used if the signal-pulse
# function itself is unreachable — leaving them unset is safe.
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_FIELD_REPORT_WEBHOOK_URL=
NEXT_PUBLIC_SIGNAL_PULSE_WEBHOOK_URL=
