# Signal Flair — environment variables
# Copy to .env.local for local dev, or set in Netlify → Site settings → Environment variables.
# NEXT_PUBLIC_ values are build-time inlined (static export) — changing one needs a rebuild.
# Values WITHOUT the NEXT_PUBLIC_ prefix are server-side only (Netlify Functions).

# Google Analytics 4 Measurement ID (GA4 → Admin → Data Streams → your stream → "G-XXXXXXXXXX").
# Leave empty / unset to disable analytics entirely (no gtag script, no events). Set it to go live.
NEXT_PUBLIC_GA_ID=

# ─────────────────────────────────────────────────────────────────────────────
# Lead routing
#
# PRIMARY (no env var needed): Netlify Forms. Both forms — homepage "field-report"
# and /pulse "signal-pulse" — are registered via data-netlify markup in the static
# export. Netlify → Forms → Notifications sends every submission to
# outreach@trysignalflair.com. This channel has no GHL dependency and keeps working
# after the GHL sub-account is cancelled.
#
# SECONDARY (optional, while GHL is still active): the vars below. A submission is
# reported as successful if EITHER channel accepts it, so leaving these unset is safe.
# ─────────────────────────────────────────────────────────────────────────────

# Field Report intake endpoint (platform-neutral — Jarvis or another router can use this).
# Recommended value while GHL is live: /.netlify/functions/lead-intake
#   — that function upserts the contact through the official GHL Contacts API.
#     It needs the server-side GHL_API_KEY below. The older GHL *inbound webhook*
#     path is deprecated: the webhook was found orphaned (its workflow had been
#     deleted) and it accepted leads that then executed nothing.
NEXT_PUBLIC_FIELD_REPORT_WEBHOOK_URL=

# Legacy GHL inbound-webhook URL (GHL → Automation → Workflows → Inbound Webhook trigger).
# Only used if FIELD_REPORT_WEBHOOK_URL is unset. Deprecated — see the note above.
NEXT_PUBLIC_GHL_WEBHOOK_URL=

# Signal Pulse™ client-side fallback webhook (only used if the Netlify function is unreachable).
NEXT_PUBLIC_SIGNAL_PULSE_WEBHOOK_URL=

# Server-side only (Netlify Functions) — never NEXT_PUBLIC_, never committed.
# GHL Private Integration token with the contacts scope; used by lead-intake + signal-pulse.
# Unset it when the GHL sub-account is cancelled — Netlify Forms carries lead delivery alone.
GHL_API_KEY=
GHL_LOCATION_ID=
