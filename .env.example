# Signal Flair — environment variables
# Copy to .env.local for local dev, or set in Netlify → Site settings → Environment variables.
# Every value here is build-time inlined (NEXT_PUBLIC_ prefix) because the site is a static export.

# Google Analytics 4 Measurement ID (GA4 → Admin → Data Streams → your stream → "G-XXXXXXXXXX").
# Leave empty / unset to disable analytics entirely (no gtag script, no events). Set it to go live.
NEXT_PUBLIC_GA_ID=

# Field Report intake webhook (platform-neutral — Jarvis or other routers can use this).
# Falls back to NEXT_PUBLIC_GHL_WEBHOOK_URL if unset. REQUIRED for live submissions.
NEXT_PUBLIC_FIELD_REPORT_WEBHOOK_URL=

# GHL inbound-webhook URL (GHL → Automation → Workflows → Inbound Webhook trigger).
# Used when FIELD_REPORT_WEBHOOK_URL is unset. Inlined at build time (static export).
NEXT_PUBLIC_GHL_WEBHOOK_URL=

# Signal Pulse landing page (/pulse) intake webhook — SEPARATE from the website's
# Field Report intake, so those landing-page leads land in their own GHL workflow /
# notification email. Point this at a dedicated GHL Inbound Webhook trigger. Falls back to
# FIELD_REPORT_WEBHOOK_URL → GHL_WEBHOOK_URL if unset; every Signal Pulse lead is tagged
# source=signal-pulse / lead_tag="Signal Pulse Request" so GHL can route + notify these
# separately even on a shared webhook.
NEXT_PUBLIC_SIGNAL_PULSE_WEBHOOK_URL=
