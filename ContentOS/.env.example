# Content OS environment configuration.
# Copy to .env (or set real environment variables). NEVER commit .env.

CONTENTOS_ENV=development
CONTENTOS_ROOT=
CONTENTOS_DATABASE_URL=sqlite:///data/contentos.db

CONTENTOS_INPUT_DIR=Input/inbox
CONTENTOS_OUTPUT_DIR=Output
CONTENTOS_KNOWLEDGE_DIR=Knowledge_Base

CONTENTOS_WHISPER_MODEL=large-v3
CONTENTOS_WHISPER_DEVICE=cuda
CONTENTOS_WHISPER_COMPUTE_TYPE=float16
CONTENTOS_WHISPER_LANGUAGE=en
CONTENTOS_WHISPER_CPU_FALLBACK=true
CONTENTOS_TRANSCRIPTION_ADAPTER=auto

CONTENTOS_OLLAMA_URL=http://127.0.0.1:11434
CONTENTOS_OLLAMA_MODEL=qwen3:14b
CONTENTOS_LLM_ADAPTER=auto

# Optional API providers (all features degrade gracefully without them)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=
FIRECRAWL_API_KEY=
BRAVE_SEARCH_API_KEY=
YOUTUBE_API_KEY=

ZERNIO_API_KEY=
ZERNIO_PROFILE_ID=

CONTENTOS_PREMIERE_MCP_ENABLED=false
CONTENTOS_PREMIERE_MCP_COMMAND=
CONTENTOS_PREMIERE_MCP_ARGS=
CONTENTOS_PREMIERE_MCP_TIMEOUT_SECONDS=120

CONTENTOS_DEFAULT_MODE=review_required
CONTENTOS_AUTOPILOT_MIN_SCORE=95
CONTENTOS_AUTOPILOT_APPROVAL_COUNT=5
CONTENTOS_DISTRIBUTION_DRY_RUN=true

# Set to 1 to show full stack traces from the CLI
CONTENTOS_DEBUG=
