{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Content OS edit plan",
  "type": "object",
  "required": ["plan_id", "job_id", "format_id", "source_asset", "clip",
               "segments", "cuts", "variants"],
  "properties": {
    "plan_id": {"type": "string"},
    "job_id": {"type": "string"},
    "format_id": {"type": "string"},
    "revision": {"type": "integer", "minimum": 0},
    "source_asset": {"type": "string"},
    "clip": {
      "type": "object",
      "required": ["start", "end"],
      "properties": {
        "start": {"type": "number", "minimum": 0},
        "end": {"type": "number", "exclusiveMinimum": 0},
        "candidate_id": {"type": ["string", "null"]},
        "score": {"type": ["number", "null"]}
      }
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_in", "source_out", "timeline_in", "timeline_out", "order"],
        "properties": {
          "source_in": {"type": "number", "minimum": 0},
          "source_out": {"type": "number", "exclusiveMinimum": 0},
          "timeline_in": {"type": "number", "minimum": 0},
          "timeline_out": {"type": "number", "exclusiveMinimum": 0},
          "order": {"type": "integer", "minimum": 0},
          "reorder_reason": {"type": ["string", "null"]}
        }
      }
    },
    "cuts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["start", "end", "action", "reason", "confidence"],
        "properties": {
          "start": {"type": "number"},
          "end": {"type": "number"},
          "action": {"type": "string", "enum": ["remove", "flagged"]},
          "reason": {"type": "string"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    },
    "captions": {"type": "object"},
    "audio": {"type": "object"},
    "variants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "aspect", "width", "height"],
        "properties": {
          "name": {"type": "string"},
          "aspect": {"type": "string"},
          "width": {"type": "integer", "minimum": 16},
          "height": {"type": "integer", "minimum": 16}
        }
      }
    },
    "broll_placeholders": {"type": "array"},
    "markers": {"type": "array"},
    "notes": {"type": "array", "items": {"type": "string"}}
  }
}
