{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Premiere sequence manifest",
  "type": "object",
  "required": ["manifest_version", "job_id", "source_assets", "sequences"],
  "properties": {
    "manifest_version": {"type": "string"},
    "job_id": {"type": "string"},
    "project_name": {"type": "string"},
    "source_assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["asset_id", "path"],
        "properties": {
          "asset_id": {"type": "string"},
          "path": {"type": "string"},
          "sha256": {"type": "string"}
        }
      }
    },
    "sequences": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "width", "height", "frame_rate", "clips"],
        "properties": {
          "name": {"type": "string"},
          "width": {"type": "integer", "minimum": 16},
          "height": {"type": "integer", "minimum": 16},
          "frame_rate": {"type": "number", "exclusiveMinimum": 0},
          "clips": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["asset_id", "source_in", "source_out", "timeline_in"],
              "properties": {
                "asset_id": {"type": "string"},
                "source_in": {"type": "number", "minimum": 0},
                "source_out": {"type": "number", "exclusiveMinimum": 0},
                "timeline_in": {"type": "number", "minimum": 0},
                "track": {"type": "integer", "minimum": 1},
                "transform": {"type": "object"}
              }
            }
          },
          "captions": {
            "type": "object",
            "properties": {
              "srt": {"type": ["string", "null"]},
              "mode": {"type": "string", "enum": ["sidecar", "burned", "none"]}
            }
          },
          "markers": {"type": "array", "items": {"type": "object"}},
          "export": {"type": "object"}
        }
      }
    },
    "notes": {"type": "array", "items": {"type": "string"}}
  }
}
